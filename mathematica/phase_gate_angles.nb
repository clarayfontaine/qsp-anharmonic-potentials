Cell[CellGroupData[{
Cell["4. Check against the target", "Section"],

Cell["Real and imaginary parts of the ideal exp(-i f) against the compiled P-block (Pfinal, multiplied by Exp[I order beta x/2] to undo the harmonic shift of Section 1), and the potential recovered from the compiled phase, -Im Log[...], against f. Agreement is expected across -2 <= x <= 2, with the largest deviations near the interval edges.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "f"}], "]"}], "]"}], ",", 
     RowBox[{"Re", "[", 
      RowBox[{"Pfinal", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "order", " ", "\[Beta]", " ", 
         RowBox[{"x", "/", "2"}]}], "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "\[Beta]"}], ",", 
     RowBox[{"\[Pi]", "/", "\[Beta]"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Real part of U(x)\>\""}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Ideal\>\"", ",", "\"\<Approximation\>\""}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Dashed"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<Re\>\""}], "}"}]}], ",", 
   RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Im", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "f"}], "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"Pfinal", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "order", " ", "\[Beta]", " ", 
         RowBox[{"x", "/", "2"}]}], "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "\[Beta]"}], ",", 
     RowBox[{"\[Pi]", "/", "\[Beta]"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Imaginary part of U(x)\>\""}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Ideal\>\"", ",", "\"\<Approximation\>\""}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Dashed"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<Im\>\""}], "}"}]}], ",", 
   RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"f", ",", 
     RowBox[{"-", 
      RowBox[{"Im", "[", 
       RowBox[{"Log", "[", 
        RowBox[{"Pfinal", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "order", " ", "\[Beta]", " ", 
           RowBox[{"x", "/", "2"}]}], "]"}]}], "]"}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], "/", "\[Beta]"}], ",", 
     RowBox[{"\[Pi]", "/", "\[Beta]"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Potential\>\""}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Ideal\>\"", ",", "\"\<Approximation\>\""}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Black", ",", "Dashed", ",", "Dashed", ",", "Dashed"}], "}"}]}], 
   ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<U(x)\>\""}], "}"}]}], ",", 
   RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}]}], "Input",
