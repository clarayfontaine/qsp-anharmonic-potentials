          RowBox[{
           RowBox[{
            RowBox[{"Dimensions", "[", "var", "]"}], "\[LeftDoubleBracket]", 
            "1", "\[RightDoubleBracket]"}], "/", "2"}]}], "}"}]}], "]"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"minvar2", "=", 
