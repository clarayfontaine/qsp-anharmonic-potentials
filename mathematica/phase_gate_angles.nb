Cell[CellGroupData[{
Cell["3. Rotation angles", "Section"],

Cell["RR[theta, phi, lambda] is the single-qubit rotation used for each layer. matrixProduct multiplies a list of matrices in order.", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RR", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"I", " ", "\[Lambda]"}], "+", 
          RowBox[{"I", " ", "\[Phi]"}]}], "]"}], 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Phi]"}], "]"}], 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}]},
      {
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "\[Lambda]"}], "]"}], 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
       RowBox[{"-", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}
     }], "\[NoBreak]", ")"}]}], 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "rotation", " ", "matrix"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matrixProduct", "[", "listOfMatrices_", "]"}], ":=", 
  RowBox[{"Dot", "@@", "listOfMatrices"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "function", " ", "to", " ", "calculate", " ", 
    "the", " ", "product", " ", "of", " ", "matrices", " ", "from", " ", "a", 
    " ", "list"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9309620908086376`*^9, 3.9309620910314927`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"680ade2a-96d5-4b29-93b6-166f1c8cd29c"],

Cell["Layer stripping. Starting from P and Q, each step reads off the highest-order coefficients a1 (of P) and b1 (of Q), sets theta = ArcTan[|b1|/|a1|] and phi = Arg[a1/b1], and applies the inverse rotation, which lowers the degree of both polynomials by one. After M steps the remainder is a constant, whose phase gives the final lambda. angPra lists the angles in stripping order; angCD reverses them into circuit (time) order, with lambda on the first rotation. The last three lines rebuild the circuit from these angles, alternating rotations with the controlled displacement diag(w, 1), and keep its top-left element as Pfinal.", "Text"],

Cell["Note: the line defining cq uses Exp[I xi] where the optimisation used Exp[I Pi xi]. The angles run in the experiment come from this line as written. Writing Exp[I Pi ...] instead gives a circuit closer to the Fourier-truncated gate: about half the phase error but about twice the amplitude error, with a similar overall operator error. Every result in the paper is compared with the circuit actually run, so the choice does not affect any claim.", "Text"],

Cell[BoxData[{
 RowBox[{"(*", " ", "As run: Exp[I xi] (see note above). ", "*)"}], "\[IndentingNewLine]",  RowBox[{
  RowBox[{"cq", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", 
       RowBox[{
        RowBox[{
        "sol2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
        "\[LeftDoubleBracket]", 
        RowBox[{
         RowBox[{"2", "n"}], "-", "1"}], "\[RightDoubleBracket]"}], "]"}], 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"Last", "[", 
         RowBox[{
          RowBox[{
          "sol2", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
          "\[LeftDoubleBracket]", 
          RowBox[{"2", "n"}], "\[RightDoubleBracket]"}], "]"}]}], "]"}]}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "var", "]"}], "\[LeftDoubleBracket]", "1",
          "\[RightDoubleBracket]"}], "/", "2"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pd", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"co", "\[LeftDoubleBracket]", 
         RowBox[{"n", "+", "1"}], "\[RightDoubleBracket]"}], 
        SuperscriptBox["w", "n"]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}], "//", "N"}], "//",
     "Expand"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qd", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"cq", "\[LeftDoubleBracket]", 
         RowBox[{"n", "+", "1"}], "\[RightDoubleBracket]"}], 
        SuperscriptBox["w", "n"]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}], "//", "N"}], "//",
     "Expand"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Dimensions", "[", "var", "]"}], "\[LeftDoubleBracket]", "1", 
     "\[RightDoubleBracket]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"angPra", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"a1", "=", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Pd", "*", 
            SuperscriptBox["w", "dim"]}], ",", 
           SuperscriptBox["w", 
            RowBox[{"dim", "+", "order", "-", 
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}]}]]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"b1", "=", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Qd", "*", 
            SuperscriptBox["w", "dim"]}], ",", 
           SuperscriptBox["w", 
            RowBox[{"dim", "+", "order", "-", 
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}]}]]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Theta]d", "=", 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "b1", "]"}], "/", 
           RowBox[{"Abs", "[", "a1", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Phi]d", "=", 
         RowBox[{"Arg", "[", 
          RowBox[{"a1", "/", "b1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"PdN", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", "\[Phi]d"}], "]"}], 
             RowBox[{"Cos", "[", "\[Theta]d", "]"}], 
             RowBox[{"Pd", "/", "w"}]}], "+", 
            RowBox[{
             RowBox[{"Sin", "[", "\[Theta]d", "]"}], 
             RowBox[{"Qd", "/", "w"}]}]}], "//", "Expand"}], "//", "Chop"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"QdN", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", "\[Phi]d"}], "]"}], 
             RowBox[{"Sin", "[", "\[Theta]d", "]"}], "Pd"}], "-", 
            RowBox[{
             RowBox[{"Cos", "[", "\[Theta]d", "]"}], "Qd"}]}], "//", 
           "Expand"}], "//", "Chop"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Pd", "=", "PdN"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Qd", "=", "QdN"}], ";", "\[IndentingNewLine]", "\[Theta]d"}],
        ",", "\[IndentingNewLine]", "\[Phi]d", ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "\[Equal]", 
          RowBox[{"dim", "-", "1"}]}], ",", 
         RowBox[{"Arg", "[", 
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Qd", "*", 
             SuperscriptBox["w", "dim"]}], ",", 
            SuperscriptBox["w", "dim"]}], "]"}], "]"}], ",", "0"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "dim"}], "}"}]}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "there", " ", "are", " ", "three", " ", "parameters", " ", "of", " ", 
     "each", " ", "rotation", " ", "Rd"}], ",", " ", 
    RowBox[{"they", " ", "are", " ", "\[Theta]d"}], ",", " ", 
    RowBox[{"\[Phi]d", " ", "and", " ", "\[Lambda]d"}]}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"angCD", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"angPra", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "angPra", "]"}], "\[LeftDoubleBracket]",
            "1", "\[RightDoubleBracket]"}], "-", "n"}], 
         "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "1", 
        "\[RightDoubleBracket]"}], ",", 
       RowBox[{
        RowBox[{"angPra", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "angPra", "]"}], "\[LeftDoubleBracket]",
            "1", "\[RightDoubleBracket]"}], "-", "n"}], 
         "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "2", 
        "\[RightDoubleBracket]"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "\[Equal]", "0"}], ",", 
         RowBox[{
          RowBox[{"angPra", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "angPra", "]"}], 
             "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "-", "n",
             "-", "1"}], "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", 
          "3", "\[RightDoubleBracket]"}], ",", "0"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "angPra", "]"}], "\[LeftDoubleBracket]", 
         "1", "\[RightDoubleBracket]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listofmatrix", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"RR", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "angPra", "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}], 
          "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
         RowBox[{
          RowBox[{
          "angPra", "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}], 
          "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", "0"}], 
        "]"}], ".", 
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {"w", "0"},
          {"0", "1"}
         }], "\[NoBreak]", ")"}]}], "//", "N"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "order"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"finalmatrix", "=", 
   RowBox[{
    RowBox[{"matrixProduct", "[", "listofmatrix", "]"}], ".", 
    RowBox[{"RR", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"angPra", "\[LeftDoubleBracket]", 
        RowBox[{"order", "+", "1"}], "\[RightDoubleBracket]"}], 
       "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
      RowBox[{
       RowBox[{"angPra", "\[LeftDoubleBracket]", 
        RowBox[{"order", "+", "1"}], "\[RightDoubleBracket]"}], 
       "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", 
      RowBox[{
       RowBox[{
       "angPra", "\[LeftDoubleBracket]", "order", "\[RightDoubleBracket]"}], 
       "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pfinal", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "finalmatrix", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
      "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "/.", 
     RowBox[{"{", 
      RowBox[{"w", "\[Rule]", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "x", " ", "\[Beta]"}], "]"}]}], "}"}]}], "//",
     "Expand"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.930962429382727*^9, 3.9309624436467195`*^9}, {
