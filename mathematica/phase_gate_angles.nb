Cell["Multistart minimisation: 50 local minimisations (interior point, up to 1500 iterations) from random seeds r_n in [0, 1], xi_n in [-1, 1]. The runs are sorted by cost and the best one is stored in sol2 = {cost, {r1 -> ..., xi1 -> ..., ...}}, which the rest of the notebook reads. A residual cost of order 1e-3 is typical; the circuit is unitary regardless, and the remaining mismatch shows up as a small difference between the compiled and target operator, which the paper accounts for by comparing every measurement with the compiled circuit.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"MULTISTART", " ", "OPTIMIZATION", " ", "FOR", " ", "Q", 
    RowBox[{"(", "w", ")"}], " ", "VARIABLES"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"numStarts", "=", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allResults", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Initialize", " ", "an", " ", "empty", " ", "list", " ", "to", " ", 
     "store", " ", "all", " ", "runs"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{"(*", 
        RowBox[{
        "1.", " ", "Generate", " ", "random", " ", "seeds", " ", "for", " ", 
         "r_n", " ", "and", " ", "\[Xi]_n"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"randomSeeds", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ToExpression", "[", 
                   RowBox[{"\"\<r\>\"", "<>", 
                    RowBox[{"ToString", "[", "n", "]"}]}], "]"}], ",", 
                  RowBox[{"RandomReal", "[", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "1"}], "}"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ToExpression", "[", 
                   RowBox[{"\"\<\[Xi]\>\"", "<>", 
                    RowBox[{"ToString", "[", "n", "]"}]}], "]"}], ",", 
                  RowBox[{"RandomReal", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}], "}"}]}], 
               "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", 
                RowBox[{"order", "+", "1"}]}], "}"}]}], "]"}], ",", "1"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "2.", " ", "Run", " ", "the", " ", "local", " ", "optimizer"}], 
          "*)"}], 
         RowBox[{"Quiet", "[", 
          RowBox[{"currentRun", "=", 
           RowBox[{"FindMinimum", "[", 
            RowBox[{"Expression1", ",", "randomSeeds", ",", 
             RowBox[{"MaxIterations", "->", "1500"}], ",", 
             RowBox[{"Method", "->", "\"\<InteriorPoint\>\""}]}], "]"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "3.", " ", "Store", " ", "the", " ", "result", " ", "in", " ", 
           "our", " ", "master", " ", "list"}], "*)"}], 
         RowBox[{"(*", 
          RowBox[{"Format", " ", "of", " ", "currentRun", " ", "is", " ", 
           RowBox[{"{", 
            RowBox[{"cost", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"r1", "->", "val"}], ",", 
               RowBox[{"\[Xi]1", "->", "val"}], ",", "..."}], "}"}]}], 
            "}"}]}], "*)"}], 
         RowBox[{"AppendTo", "[", 
          RowBox[{"allResults", ",", "currentRun"}], "]"}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"start", ",", "1", ",", "numStarts"}], "}"}]}], "]"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Running seed: \>\"", ",", "start", ",", "\"\</\>\"", ",", 
         "numStarts"}], "}"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Sort", " ", "all", " ", "results", " ", "by", " ", "their", 
     " ", "cost", " ", "function", " ", 
     RowBox[{"(", 
      RowBox[{"lowest", " ", "cost", " ", "first"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allResults", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{"allResults", ",", "First"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", 
     RowBox[{"Set", "'"}], 
     RowBox[{"sol2", "'"}], " ", "to", " ", "the", " ", "absolute", " ", 
     "best", " ", "result", " ", "so", " ", "the", " ", "rest", " ", "of", 
     " ", "your", " ", "script", " ", "still", " ", "works", " ", 
     "smoothly"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2", "=", 
     RowBox[{"allResults", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bestCost", "=", 
     RowBox[{"sol2", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Optimization Complete!\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total seeds evaluated: \>\"", ",", 
      RowBox[{"Length", "[", "allResults", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Best Cost Found: \>\"", ",", "bestCost"}], "]"}], 
    ";"}]}]}]], "Input",
