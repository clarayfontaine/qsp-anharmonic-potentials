Cell["Angles in the ECD convention (as run on hardware)", "Subsection"],

Cell["The hardware uses echoed conditional displacements, which also flip the qubit: U_ECD = e^{i beta x}|e><g| + e^{-i beta x}|g><e|. Absorbing the flip into the rotations gives theta -> Pi/2 - theta, phi -> phi - Pi and lambda -> -lambda for every rotation after the first (angles taken mod 2 Pi); the first rotation is unchanged. angECD is the list uploaded to the experiment.", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"when", " ", "we", " ", "consider", " ", 
     SubscriptBox["U", "ECD"]}], "=", 
    RowBox[{
     SuperscriptBox["e", "i\[Beta]x"], "|", 
     RowBox[{"e", ">", "<", "g"}], "|", 
     RowBox[{"+", 
      SuperscriptBox["e", 
       RowBox[{"-", "i\[Beta]x"}]]}], "|", 
     RowBox[{"g", ">", "<", "e"}], "|"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"The", " ", "mappings", " ", "are", " ", "\[Theta]d"}], " ", 
     "\[Rule]", " ", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "2"}], "-", "\[Theta]d"}]}], ",", " ", 
    RowBox[{
     RowBox[{"\[Phi]d", " ", "\[Rule]", " ", 
      RowBox[{
       RowBox[{"\[Phi]d", "-", 
        RowBox[{"\[Pi]", " ", "and", " ", "\[Lambda]d"}]}], "\[Rule]", 
       RowBox[{
        RowBox[{"-", "\[Lambda]d"}], " ", "for", " ", "d"}]}]}], "=", "2"}], 
    ",", 
    RowBox[{"3", "..."}], ",", 
    RowBox[{
     RowBox[{"N", "+", 
      RowBox[{
      "1", " ", "and", " ", "no", " ", "change", " ", "for", " ", "d"}]}], 
     "=", "1"}]}], "*)"}]}]], "Input",
