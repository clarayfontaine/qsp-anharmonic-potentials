Cell[CellGroupData[{
Cell["2. Complementary polynomial Q", "Section"],

Cell["A QSP circuit implements a 2x2 unitary whose top-left element is P(w). Unitarity requires a partner Q(w) of the same degree with |P(w)|^2 + |Q(w)|^2 = 1 on the unit circle. Writing the coefficients of Q as b_n = r_n Exp[I Pi xi_n] (r_n >= 0, -1 <= xi_n <= 1), the cell below multiplies out 1 - P P* - Q Q*, collects its coefficient of each power of w, and sums their squared magnitudes into the cost Expression1. The cost is zero exactly when Q is complementary.", "Text"],

Cell["The commented-out block at the end of this cell is an earlier single-start minimisation (NMinimize followed by repeated FindMinimum). It is kept for reference and is not executed.", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PPstar", "=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"co", "\[LeftDoubleBracket]", 
        RowBox[{"n", "+", "1"}], "\[RightDoubleBracket]"}], 
       SuperscriptBox["w", "n"]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}], "*", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"co", "\[LeftDoubleBracket]", 
         RowBox[{"n", "+", "1"}], "\[RightDoubleBracket]"}], "]"}], 
       SuperscriptBox["w", 
        RowBox[{"-", "n"}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QQstar", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ToExpression", "[", 
            RowBox[{"\"\<r\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"n", "+", "1"}], "]"}]}], "]"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", 
             RowBox[{"ToExpression", "[", 
              RowBox[{"\"\<\[Xi]\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"n", "+", "1"}], "]"}]}], "]"}], "\[Pi]"}], "]"}]}], 
          ")"}], 
         SuperscriptBox["w", "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ToExpression", "[", 
            RowBox[{"\"\<r\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"n", "+", "1"}], "]"}]}], "]"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"ToExpression", "[", 
              RowBox[{"\"\<\[Xi]\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"n", "+", "1"}], "]"}]}], "]"}], "\[Pi]"}], "]"}]}], 
          ")"}], 
         SuperscriptBox["w", 
          RowBox[{"-", "n"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}]}], "//", 
     "Expand"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"set", " ", "up", " ", "the", " ", "expression", " ", "of"}], " ",
     "|", "Q", "|", 
    RowBox[{"^", "2"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"var", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ToExpression", "[", 
          RowBox[{"\"\<r\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"n", "+", "1"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"ToExpression", "[", 
          RowBox[{"\"\<\[Xi]\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"n", "+", "1"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "order"}], "}"}]}], "]"}], "]"}]}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Here", " ", "bn"}], "=", 
    RowBox[{"rn", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", "*", "\[Xi]n", "*", "\[Pi]"}], "]"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "PPstar", "-", "QQstar"}], ")"}], "*", 
     SuperscriptBox["w", "order"]}], "//", "Expand"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ss", "=", 
   RowBox[{"CoefficientList", "[", 
    RowBox[{"s", ",", "w"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Expression1", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"ComplexExpand", "[", 
            RowBox[{"Re", "[", "ss", "]"}], "]"}], ")"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"ComplexExpand", "[", 
            RowBox[{"Im", "[", "ss", "]"}], "]"}], ")"}], "2"]}], ")"}], 
       "\[LeftDoubleBracket]", "n", "\[RightDoubleBracket]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", 
        RowBox[{
         RowBox[{"Dimensions", "[", "ss", "]"}], "\[LeftDoubleBracket]", "1", 
         "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"set", " ", "up", " ", "the", " ", "array", " ", "contains", " ", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "-"}], "|", 
        RowBox[{"P", 
         RowBox[{"(", "w", ")"}]}], 
        SuperscriptBox["|", "2"], 
        RowBox[{"-", 
         RowBox[{"|", 
          RowBox[{"Q", 
           RowBox[{"(", "w", ")"}]}], 
          SuperscriptBox["|", "2"]}]}]}], ",", 
       SuperscriptBox["w", "n"]}], "]"}]}], ",", " ", 
    RowBox[{
    "and", " ", "then", " ", "minimize", " ", "the", " ", "length", " ", "of",
      " ", "that", " ", "array", " ", "to", " ", "determine", " ", "the", " ",
      "coefficents"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sol1", "=", 
     RowBox[{"NMinimize", "[", 
      RowBox[{"Expression1", ",", "var"}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Determine", " ", "bn"}], "=", 
      RowBox[{"rn", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", "*", "\[Xi]n", "*", "\[Pi]"}], "]"}], " ", "by", " ", 
       "minimization"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"minvar", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ToExpression", "[", 
             RowBox[{"\"\<r\>\"", "<>", 
              RowBox[{"ToString", "[", "n", "]"}]}], "]"}], ",", 
            RowBox[{"Last", "[", 
             RowBox[{
              RowBox[{
              "sol1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[LeftDoubleBracket]", 
              RowBox[{
               RowBox[{"2", "n"}], "-", "1"}], "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ToExpression", "[", 
             RowBox[{"\"\<\[Xi]\>\"", "<>", 
              RowBox[{"ToString", "[", "n", "]"}]}], "]"}], ",", 
            RowBox[{"Last", "[", 
             RowBox[{
              RowBox[{
              "sol1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
              "\[LeftDoubleBracket]", 
              RowBox[{"2", "n"}], "\[RightDoubleBracket]"}], "]"}]}], "}"}]}],
          "}"}], ",", 
        RowBox[{"{", 
